{
  "name": "margaret-pos",
  "version": "0.3.1",
  "private": true,
  "description": "Demo de administración y punto de venta Margaret",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:pages": "npm run build && node scripts/prepare-pages.mjs",
    "test": "node scripts/test.mjs",
    "check:security": "node scripts/check-security.mjs",
    "qa:fixtures": "npm run build && node scripts/prepare-qa.mjs",
    "test:e2e": "npm run qa:fixtures && playwright test",
    "start": "npm run dev",
    "dev": "node --env-file-if-exists=.env.local scripts/serve.mjs",
    "check:version": "node scripts/check-version.mjs",
    "check:production": "node scripts/production-readiness.mjs",
    "prepare:release": "node scripts/package-release.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
